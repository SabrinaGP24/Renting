<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <appSettings>
        <!--
          Proveedor de persistencia. Valores admitidos:
            InMemory   -> la aplicacion arranca sin ninguna dependencia externa (valor por defecto)
            Oracle     -> requiere la cadena de conexion "OracleDb"    (docker-compose up oracle)
            SqlServer  -> requiere la cadena de conexion "SqlServerDb" (docker-compose up sqlserver
                          o una instancia local gestionada con SQL Server Management Studio)
        -->
        <add key="PersistenceProvider" value="InMemory" />
    </appSettings>

    <connectionStrings>
        <add name="OracleDb"
             connectionString="User Id=RENTING;Password=renting;Data Source=localhost:1521/XEPDB1;"
             providerName="Oracle.ManagedDataAccess.Client" />
        <add name="SqlServerDb"
             connectionString="Server=localhost,1433;Database=RENTING;User Id=sa;Password=Renting_2024!;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
