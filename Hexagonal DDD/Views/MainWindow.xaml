<Window x:Class="WPF_Hexagonal_DDD.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WPF_Hexagonal_DDD.Views.Converters"
        Title="Renting - Gestion de flota" Height="560" Width="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:VehicleStatusConverter x:Key="VehicleStatusConverter" />
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera del listado -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
            <TextBlock Text="Flota" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding RefreshCommand}" />
            <CheckBox DockPanel.Dock="Right" Content="Solo disponibles" Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowOnlyAvailable, Mode=TwoWay}" />
            <TextBlock />
        </DockPanel>

        <!-- Listado de vehiculos -->
        <DataGrid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"
                  ItemsSource="{Binding Vehicles}"
                  SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Matricula" Binding="{Binding PlateNumber}" Width="110" />
                <DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="*" />
                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" />
                <DataGridTextColumn Header="Fabricacion"
                                    Binding="{Binding ManufactureDate, StringFormat=\{0:dd/MM/yyyy\}}"
                                    Width="110" />
                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Status, Converter={StaticResource VehicleStatusConverter}}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Panel de acciones -->
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <GroupBox Header="Alta de vehiculo" Padding="10">
                <StackPanel>
                    <TextBlock Text="Matricula" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewPlateNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Marca" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewBrand, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Modelo" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewModel, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Fecha de fabricacion" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding NewManufactureDate, Mode=TwoWay}" />

                    <TextBlock Text="No se admiten vehiculos con mas de 5 años de antiguedad."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,6,0,0" />

                    <Button Content="Dar de alta" Command="{Binding AddVehicleCommand}"
                            HorizontalAlignment="Right" Margin="0,10,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Alquiler y devolucion" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Vehiculo seleccionado" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedVehicle.PlateNumber, TargetNullValue=(ninguno)}"
                               FontSize="14" />
                    <TextBlock Text="{Binding SelectedVehicle.Brand}" Foreground="Gray" />

                    <TextBlock Text="Al alquilar se pediran los datos del cliente. Una persona no puede tener mas de un vehiculo alquilado a la vez."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Alquilar..." Click="OnRentClick" Margin="0,0,8,0"
                                IsEnabled="{Binding CanRentSelectedVehicle}" />
                        <Button Content="Devolver" Command="{Binding ReturnCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Barra de estado -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                Padding="10,6" Background="#F2F2F2" CornerRadius="3">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#1B5E20" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="#B71C1C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
